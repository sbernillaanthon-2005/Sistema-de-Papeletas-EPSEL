# ─────────────────────────────────────────────────────────────────────────────
# EPSEL Papeletas — .env.example
# Copiar a .env y ajustar valores antes de levantar Docker
# ─────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────
# App
# ──────────────────────────────
APP_NAME="EPSEL-Papeletas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Lima
APP_LOCALE=es

# ──────────────────────────────
# Logging
# ──────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────
# Base de datos (PostgreSQL)
# ──────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=epsel_papeletas
DB_USERNAME=epsel
DB_PASSWORD=secret

# ──────────────────────────────
# Caché / Sesión
# ──────────────────────────────
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# ──────────────────────────────
# Colas
# ──────────────────────────────
QUEUE_CONNECTION=database

# ──────────────────────────────
# Broadcasting (Reverb)
# ──────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=epsel_papeletas
REVERB_APP_KEY=epsel_reverb_key
REVERB_APP_SECRET=epsel_reverb_secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Reverb desde el navegador (frontend)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ──────────────────────────────
# Mail (Mailtrap para dev)
# ──────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@epsel.pe"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────
# Sanctum
# ──────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:5173

# ──────────────────────────────
# Almacenamiento de firmas/sellos
# ──────────────────────────────
FILESYSTEM_DISK=local
SIGNATURE_DISK=private

# ──────────────────────────────
# Docker / Puertos de servicios
# ──────────────────────────────
NGINX_PORT=8000
DB_EXPOSED_PORT=5432
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@epsel.pe
PGADMIN_PASSWORD=admin123
REVERB_PORT=8080
VITE_PORT=5173
